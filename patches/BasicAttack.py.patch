+def OwnCloakModule(pShip):
+	# The hull's AIString when that module sets HANDLES_CLOAK, else None.
+	try:
+		sModule = pShip.GetShipProperty().GetAIString()
+		if getattr(__import__(sModule), "HANDLES_CLOAK", 0):
+			return sModule
+	except:
+		pass
