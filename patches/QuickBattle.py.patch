+def LaunchPointLocation(pCarrier, iSlot, iNumber, fFighterRadius):
+	# Optional launch points for a carrier (2026-09-13).
+	# FighterLaunchPoints in the carrier's Bedrock plugin is a tuple of (x, y, z)
+	# offsets in the carrier's own frame - x right, y forward, z up, hardpoint
+	# units - one per fighter slot; slots past the end use the last point.  Each
+	# further fighter from the same launcher sits 3 fighter radii further out
+	# along that point's direction.  None when the carrier has no launch points,
+	# so the stock placement stands.
+	import sys
+	import string
+	try:
+		sType = string.split(pCarrier.GetScript(), ".")[-1]
+		sPath = "Custom.Bedrock.Ships." + sType
+		pPlugin = __import__(sPath, {}, {}, ["ShipName"])
+		if not hasattr(pPlugin, "ShipName"):
+			pPlugin = sys.modules[sPath]
+		if not hasattr(pPlugin, "FighterLaunchPoints"):
+			return None
+		lPoints = pPlugin.FighterLaunchPoints
+		iIndex = iSlot - 1
+		if iIndex >= len(lPoints):
+			iIndex = len(lPoints) - 1
+		if iIndex < 0:
+			return None
+		fX = float(lPoints[iIndex][0])
+		fY = float(lPoints[iIndex][1])
+		fZ = float(lPoints[iIndex][2])
+	except:
+		return None
+	fLength = pow(fX * fX + fY * fY + fZ * fZ, 0.5)
+	if fLength > 0.001:
+		fOut = 1.0 + (fFighterRadius * 3.0 * (iNumber - 1)) / fLength
+		fX = fX * fOut
+		fY = fY * fOut
+		fZ = fZ * fOut
+	kLocation = pCarrier.GetWorldLocation()
+	kRight = pCarrier.GetWorldRightTG()
+	kForward = pCarrier.GetWorldForwardTG()
+	kUp = pCarrier.GetWorldUpTG()
+	kRight.Scale(fX)
+	kForward.Scale(fY)
+	kUp.Scale(fZ)
+	kLocation.Add(kRight)
+	kLocation.Add(kForward)
+	kLocation.Add(kUp)
+	return kLocation
+
