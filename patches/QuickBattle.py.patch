+def LaunchAIWing(pBedrock, pShip, sWhichSide, sAINumber):
+	# An AI-flown carrier launches its complement here; the player's own
+	# complement is wired to XO menu buttons instead (CheckFighters).
+	#
+	# The eight stock try/except blocks this replaces guarded the ABSENCE of
+	# a FighterType slot - but they wrapped the spawn call too, so a genuine
+	# failure (missing ship script, bad plugin, full set) was swallowed with
+	# exactly the same silence as "this hull carries no fighters".  That is
+	# indistinguishable from the wing feature not existing at all.  Absence
+	# is still silent; failure now says so on the console.
+	iSlot = 1
+	while iSlot <= 8:
+		sType = None
+		iQty = 0
+		if hasattr(pBedrock, "FighterType" + str(iSlot)):
+			if hasattr(pBedrock, "FighterQuantity" + str(iSlot)):
+				sType = getattr(pBedrock, "FighterType" + str(iSlot))
+				iQty = getattr(pBedrock, "FighterQuantity" + str(iSlot))
+		# AIFighterCap in the plugin limits what an AI-flown carrier launches per slot
+		# (2026-09-28); the player's own complement is not capped.
+		if sType and hasattr(pBedrock, "AIFighterCap"):
+			try:
+				if iQty > int(pBedrock.AIFighterCap):
+					iQty = int(pBedrock.AIFighterCap)
+			except:
+				pass
+		if sType and (iQty > 0):
+			try:
+				SpawnAIFighter(sType, iQty, iSlot, pShip, sWhichSide, sAINumber)
+			except:
+				import sys
+				WingLog(pShip.GetName() + " slot " + str(iSlot) + " (" +
+					str(sType) + " x" + str(iQty) + ") FAILED: " +
+					str(sys.exc_type) + ": " + str(sys.exc_value))
+		iSlot = iSlot + 1
 
 
